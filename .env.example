# ----------------------------------------------------------------------------
# Laksar Properties — environment variable example
# Copy to .env.local for local dev. NEVER commit real secrets to the repo.
# Frontend-exposed vars (NEXT_PUBLIC_*) are public by design — do not place
# private credentials in them.
# ----------------------------------------------------------------------------

# Canonical public URL of the deployed site (used for SEO metadata, sitemap).
NEXT_PUBLIC_SITE_URL=https://www.example.in

# OPTIONAL: HTTPS endpoint that accepts lead-form JSON POSTs
# (e.g. a serverless function, Formspree, a CRM webhook).
# Leave empty to use the built-in, honest fallback delivery
# (WhatsApp deep-link / email deep-link / on-screen summary).
NEXT_PUBLIC_LEAD_ENDPOINT=
